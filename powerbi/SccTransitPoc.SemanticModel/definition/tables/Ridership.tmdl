table Ridership
	lineageTag: cc7534bb-3818-489f-b6f4-5a354bb7e1cd

	measure 'Total Boardings' = CALCULATE(SUM('Ridership'[MetricValue]), 'Ridership'[MetricName] = "boardings")
		lineageTag: 693241a1-c177-41b8-b467-e97463720a31

	measure 'Expected Riders (Prior Year)' = CALCULATE([Total Boardings], FILTER(ALL('Ridership'[CalendarYear]), 'Ridership'[CalendarYear] = MAX('Ridership'[CalendarYear]) - 1))
		lineageTag: 27f407e8-5f16-434d-bc5c-52cb727230ce

	measure 'Variance to Prior Year' = [Total Boardings] - [Expected Riders (Prior Year)]
		lineageTag: 2ebfe04c-6f47-433c-9dce-08a3b838ff83

	measure 'Variance %' = DIVIDE([Variance to Prior Year], [Expected Riders (Prior Year)])
		lineageTag: f77bc273-3331-4196-89bf-94f406605993

	measure 'Average Metric Value' = AVERAGE('Ridership'[MetricValue])
		lineageTag: a82ac2c9-709e-4d41-be11-800b348fc9fb

