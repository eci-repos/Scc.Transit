table TripPerformance
	lineageTag: 401c0758-f22e-44fa-a809-2f40078fa8e4

	measure 'Trip Update Count' = COUNTROWS(TripPerformance)
		lineageTag: ce11f01d-4308-4bd1-a8e5-e04010b2a49b

	measure 'Average Arrival Delay (min)' = DIVIDE(AVERAGE('TripPerformance'[ArrivalDelaySeconds]), 60)
		lineageTag: e0473e01-5f35-4e71-a5db-3e2c81ca73fa

	measure 'Delayed Updates' = CALCULATE(COUNTROWS('TripPerformance'), 'TripPerformance'[ArrivalDelaySeconds] > 300)
